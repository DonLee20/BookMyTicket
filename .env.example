# =============================================================================
# BookMyTicket - environment configuration
# Copy this file to .env (scripts/bootstrap-env.sh does it automatically).
# Never commit a real .env file or real secrets.
# =============================================================================

# ----- Docker / MySQL -------------------------------------------------------
MYSQL_DATABASE=bookmyticket
MYSQL_USER=bookmyticket
MYSQL_PASSWORD=changeme_local_dev
MYSQL_ROOT_PASSWORD=changeme_local_root
MYSQL_PORT=3307

# ----- Public ports ---------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8081
BACKEND_PROFILE=docker

# ----- Application ----------------------------------------------------------
# Days of demo bus trip inventory generated ahead of "today".
DEMO_BUS_DAYS_AHEAD=30
# Seed a demo administrator at startup. Leave ADMIN_PASSWORD empty to skip.
ADMIN_EMAIL=admin@bookmyticket.local
ADMIN_NAME="Platform Administrator"
ADMIN_PASSWORD=AdminDemo#2026

# ----- Provider integration modes ------------------------------------------
# Allowed values: DEMO | LIVE | EXTERNAL_HANDOFF | UNAVAILABLE
# Only DEMO is implemented today for every transport category; the adapters
# and configuration boundaries for LIVE booking are in place. See README.
BUS_PROVIDER_MODE=DEMO
RAILWAY_PROVIDER_MODE=DEMO
FLIGHT_PROVIDER_MODE=DEMO
MTC_PROVIDER_MODE=DEMO
PAYMENT_PROVIDER=demo

# Optional live credentials (never exposed to the frontend). When they are
# absent the application still starts and reports the provider as DEMO or
# UNAVAILABLE. Live booking adapters are not implemented in this release, so
# setting credentials alone never switches a provider to LIVE.
#
# Live bus inventory: a backend adapter must be installed first. Credentials
# stay in these backend environment variables and are never sent to React.
# See "Connecting live bus inventory" in README.md.
BUS_LIVE_PROVIDER=
BUS_LIVE_BASE_URL=
BUS_LIVE_API_KEY=
BUS_LIVE_API_SECRET=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
IRCTC_OFFICIAL_HANDOFF_URL=https://www.irctc.co.in/nget/train-search
MTC_OFFICIAL_INFO_URL=https://www.mtcbus.tn.gov.in/

# HMAC secret used to sign demo payment webhooks (dev placeholder; rotate it).
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret_change_me

# ----- Frontend build -------------------------------------------------------
VITE_APP_NAME=BookMyTicket
